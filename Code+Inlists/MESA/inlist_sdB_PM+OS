
! Inlist to evolve the sdB star through core helium burning (step 5 of making an sdB star)

&star_job
   ! see star/defaults/star_job.defaults

   ! Load previous model
   load_saved_model = .true.
   load_model_filename = 'after_flash.mod'

   ! Save the model at the end of the run
   save_model_when_terminate = .true.
   save_model_filename = 'sdB.mod'

   history_columns_file = 'history_columns.list'

   ! Display on-screen plots
   pgstar_flag = .true.

   ! Pause and save a photo before termination
   pause_before_terminate = .true.
   save_photo_when_terminate = .true.
   save_photo_filename = 'final_sdB.photo'

   ! Change nuclear reaction network
   change_initial_net = .true.
   new_net_name = 'basic_plus_fe56_ni58.net'

   ! Solar abundance mixture (Asplund et al. 2009)
   initial_zfracs = 6

   ! Reset model number and stellar age
   set_initial_model_number = .true.
   initial_model_number = 0
   set_initial_age = .true.
   initial_age = 0

   ! Reset the accumulated energy conservation error
   set_initial_cumulative_energy_error = .true.
   new_cumulative_energy_error = 0d0

/ ! end of star_job namelist


&eos
   ! see eos/defaults/eos.defaults

/ ! end of eos namelist


&kap
   ! see kap/defaults/kap.defaults

   ! Use Type 2 opacities to account for carbon and oxygen enhancement
   use_Type2_opacities = .true.

   ! Reference metallicity for opacity calculations
   Zbase = 0.014

   ! Use opacity tables based on the Asplund et al. (2009) solar abundances
   kap_file_prefix = 'a09'
   kap_lowT_prefix = 'lowT_fa05_a09p' ! Low-temperature opacity tables
   kap_CO_prefix = 'a09_co' ! C/O-enhanced opacity tables

/ ! end of kap namelist



&controls

   ! see star/defaults/controls.defaults

   ! Initial stellar parameters (consistent with the loaded model)
   initial_mass = 1.5 ! Solar masses
   initial_z = 0.014

   ! When to stop
   max_model_number = 20000 ! Safety limit on the model number
   xa_central_lower_limit_species(1) = 'he4'
   xa_central_lower_limit(1) = 1d-6 ! Stop at central helium exhaustion
   when_to_stop_rtol = 1d-3
   when_to_stop_atol = 1d-5

   ! Element diffusion
   do_element_diffusion = .true.
   diffusion_calculates_ionization = .true. ! Calculate ionization from local conditions

   ! Diffusion classes and representative isotopes
   diffusion_num_classes = 8

   diffusion_class_representative(1) = 'h1'
   diffusion_class_representative(2) = 'he3'
   diffusion_class_representative(3) = 'he4'
   diffusion_class_representative(4) = 'c12'
   diffusion_class_representative(5) = 'n14'
   diffusion_class_representative(6) = 'o16'
   diffusion_class_representative(7) = 'ne20'
   diffusion_class_representative(8) = 'mg24'

   ! Maximum atomic mass number assigned to each diffusion class
   diffusion_class_A_max(1) = 2
   diffusion_class_A_max(2) = 3
   diffusion_class_A_max(3) = 4
   diffusion_class_A_max(4) = 12
   diffusion_class_A_max(5) = 14
   diffusion_class_A_max(6) = 16
   diffusion_class_A_max(7) = 20
   diffusion_class_A_max(8) = 10000

   ! Diffusion solver settings
   diffusion_use_isolve = .false.
   diffusion_rtol_for_isolve = 1d-4
   diffusion_atol_for_isolve = 1d-5
   diffusion_maxsteps_for_isolve = 1000
   diffusion_isolve_solver = 'ros2_solver'

   ! Mixing length theory
   mixing_length_alpha = 1.8d0
   MLT_option = 'Cox'

   ! Mixing

      ! Predictive mixing at convective core boundaries
      predictive_mix(1) = .true.
      predictive_zone_type(1) = 'any'
      predictive_zone_loc(1) = 'core'
      predictive_bdy_loc(1) = 'any'
      predictive_superad_thresh(1) = 0.015 ! Superadiabaticity threshold
      predictive_avoid_reversal(1) = 'he4' ! Avoid reversals in helium abundance
      predictive_limit_ingestion(1) = 'he4' ! Limit helium mixing into the convective core
      predictive_ingestion_factor(1) = 0.4d0 ! Controls the helium ingestion rate

      ! Overshooting
      overshoot_scheme(:) = 'exponential'
      overshoot_zone_type(:) = 'any'
      overshoot_zone_loc(:) = 'core'
      overshoot_bdy_loc(:) = 'top'
      overshoot_f(:) = 0.016 ! Exponential mixing decay parameter
      overshoot_f0(:) = 0.005 ! Reference point inside the convective region

      ! Semiconvection
      use_Ledoux_criterion = .true.
      alpha_semiconvection = 0 ! Disable semiconvective mixing
      num_cells_for_smooth_gradL_composition_term = 0

   ! Numerical resolution and timestep controls
   varcontrol_target = 1d-3 ! Target relative change between models
   min_timestep_limit = 1d-6 ! Minimum permitted timestep in seconds
   max_years_for_timestep = 5d6 ! Maximum timestep of 5 million years
   delta_lgL_He_limit = 0.01d0 ! Limit changes in log helium-burning luminosity
   time_delta_coeff = 0.4 ! Timestep adjustment coefficient
   mesh_delta_coeff = 0.2 ! Controls spatial mesh resolution
   max_allowed_nz = 10000 ! Maximum number of mesh zones

   ! Solver settings
   energy_eqn_option = 'dedt' ! Energy equation formulation (see MESA V, Section 3)
   use_gold_tolerances = .true. ! Use stricter solver tolerances

   ! Output
   log_directory = 'LOGS'
   profile_interval = 1
   max_num_profile_models = -1
   photo_interval = 50
   photo_digits = 5
   history_interval = 1

   ! Save stellar structure data for GYRE
   write_pulse_data_with_profile = .true.
   pulse_data_format = 'GYRE'

   ! Terminal output
   terminal_interval = 50
   num_trace_history_values = 2
   trace_history_value_name(1) = 'rel_E_err'
   trace_history_value_name(2) = 'log_rel_run_E_err'

/ ! end of controls namelist


&pgstar

   !pause_flag = .true.
   Kipp_win_flag = .true.
   HR_win_flag = .true.
   
/ ! end of pgstar namelist
